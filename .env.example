# Copy to .env and fill in. .env is never committed. Which keys matter depends
# on the machine: the server, the shop PC, or the laptop (all three for testing).

# --- Telegram (server, laptop) ---
# From @BotFather. Keep it secret: whoever has it controls the bot.
TELEGRAM_TOKEN=
# Telegram user ids allowed to use the bot, comma separated. Unknown users get
# their id back when they write to the bot.
ALLOWED_USERS=
# Any long random text; Telegram sends it with each message so the server knows
# it's Telegram. python -c "import secrets; print(secrets.token_urlsafe(24))"
WEBHOOK_SECRET=

# --- The shop's database (shop PC, laptop): read by src/export.py ---
#   Laptop (the restored copy):  DB_SERVER=.\SQLEXPRESS   DB_NAME=ELyasserDB
#   Shop PC (the live program):   DB_SERVER=shop           DB_NAME=auto
DB_SERVER=.\SQLEXPRESS
DB_NAME=ELyasserDB
# Empty = log in with the Windows account.
DB_USER=
DB_PASSWORD=

# --- Shop PC -> server ---
# The server's address, e.g. https://elbaraga.pythonanywhere.com (shop PC only)
SERVER_URL=
# Same long random text on the shop PC and the server
UPLOAD_TOKEN=

# The snapshot file (default: data/snapshot.db)
SNAPSHOT_PATH=

# Testing on the restored copy: every report acts as if it were this moment
# (the copy ends on 2026-09-26). Leave EMPTY on the server and the shop PC.
AS_OF=2026-09-26 18:00

# --- Schedule (24h, Cairo time) ---
# On the server each report goes out at the first chance after its time
# (within 15 minutes with cron-job.org); the weekly one with the end of day.
# END_OF_DAY may be after midnight (e.g. 00:30): it still counts as the day before.
TIMEZONE=Africa/Cairo
DAILY_UPDATE=16:30
END_OF_DAY=23:30
WEEKLY_DAY=thu
WEEKLY_TIME=23:45     # laptop bot only

# --- Thresholds ---
VELOCITY_DAYS=60      # average daily sales are taken over this many days
LOW_STOCK_DAYS=7      # "running low" = stock lasts this many days or fewer
IDLE_DAYS=90          # "idle" = in stock but not sold for this many days
MIN_SOLD=3            # sold at least this many in VELOCITY_DAYS to count as "selling"
